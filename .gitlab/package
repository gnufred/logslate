#!/bin/bash

upload_package() {
	package_source="$1"
	package_destination="$2"
	echo "Upload: $package_source => $package_destination"
	curl \
		--header "JOB-TOKEN: ${CI_JOB_TOKEN}" \
		--upload-file \
			"${package_source}" \
			"${package_destination}"
	echo ""
}

echo "Compressing Linux package."
tar \
	-C .bin \
	-czf ".bin/${LINUX_AMD64_BINARY}.tar.gz" \
	"${LINUX_AMD64_BINARY}"

echo "Uploading Linux package."
upload_package \
	".bin/${LINUX_AMD64_BINARY}.tar.gz" \
	"${PACKAGE_REGISTRY_CURRENT}/${LINUX_AMD64_BINARY}.tar.gz"

echo "Compressing MacOS package."
tar \
	-C .bin \
	-czf ".bin/${DARWIN_AMD64_BINARY}.tar.gz" \
	"${DARWIN_AMD64_BINARY}"

echo "Uploading MacOS package."
upload_package \
	".bin/${DARWIN_AMD64_BINARY}.tar.gz" \
	"${PACKAGE_REGISTRY_CURRENT}/${DARWIN_AMD64_BINARY}.tar.gz"
