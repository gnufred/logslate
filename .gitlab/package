#!/bin/bash

upload_package() {
	package_source="$1"
	package_destination="$2"
	echo "Upload: $package_source => $package_destination"
	curl \
		--header "JOB-TOKEN: ${CI_JOB_TOKEN}" \
		--upload-file \
			"${package_source}" \
			"${package_destination}"
	echo ""
}

echo "Uploading new version packages."
upload_package \
	".bin/generic/${LINUX_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_CURRENT}/${LINUX_AMD64_BINARY}"

upload_package \
	".bin/generic/${DARWIN_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_CURRENT}/${DARWIN_AMD64_BINARY}"

upload_package \
	".bin/generic/${WINDOWS_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_CURRENT}/${WINDOWS_AMD64_BINARY}"

# Check if we're releasing a "real" version.
# We want to avoid pushing to the "latest/" endpoint if we're running test releases.
version=$(git describe --tags|grep -E '^[0-9]*\.[0-9]*\.[0-9]*$'|wc -l)
echo "Checking if we need to upload to: lastest..."
if [[ "$version" -ne "1" ]]; then
	echo "No. We don't."
	exit 0
else
	echo "Yes. We do."
fi
	
echo -e "\nUploading latest packages."

upload_package \
	".bin/generic/${LINUX_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_LATEST}/${LINUX_AMD64_BINARY}"

upload_package \
	".bin/generic/${DARWIN_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_LATEST}/${DARWIN_AMD64_BINARY}"

upload_package \
	".bin/generic/${WINDOWS_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_LATEST}/${WINDOWS_AMD64_BINARY}"
