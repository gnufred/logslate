#!/bin/bash

upload_package() {
	package_source="$1"
	package_destination="$2"
	echo "Upload: $package_source => $package_destination"
	curl \
		--header "JOB-TOKEN: ${CI_JOB_TOKEN}" \
		--upload-file \
			"${package_source}" \
			"${package_destination}"
	echo ""
}

echo "Uploading new version packages."
upload_package \
	".bin/${LINUX_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_CURRENT}/${LINUX_AMD64_BINARY}"

upload_package \
	".bin/${DARWIN_AMD64_BINARY}" \
	"${PACKAGE_REGISTRY_CURRENT}/${DARWIN_AMD64_BINARY}"
