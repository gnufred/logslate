#!/bin/bash

# To test this script in a Ubuntu docker image
# docker run -it --entrypoint "/bin/bash" ubuntu:20.04

echo "Installing Ubuntu 20.04 required packages..."
apt update
apt install -y wget gcc

ver="1.20.5"
echo "Installing Go ${ver}"
wget "https://go.dev/dl/go${ver}.linux-amd64.tar.gz"
tar -C /usr/local -xvzf "go${ver}.linux-amd64.tar.gz"
