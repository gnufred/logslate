#!/bin/bash

# hardcoded minimums
declare -A minCov
minCov[args/args.go]=96
minCov[args/sysdt/sysdt.go]=89
minCov[args/time.go]=100
minCov[db/db.go]=85
minCov[debug/debug.go]=86
minCov[main.go]=89
minCov[pipe/pipe.go]=90
minCov[prof/prof.go]=79
minCov[report/format.go]=100
minCov[report/layout.go]=100
minCov[report/options.go]=100
minCov[report/print.go]=90
minCov[report/report.go]=100
minCov[root/root.go]=95
minCov[test/test.go]=72
minCov[threat/ahocorasick.go]=100
minCov[threat/attacks.go]=100
minCov[threat/detect.go]=100
minCov[translate/slate.go]=100
minCov[translate/threat.go]=100

# prepare script execution
root_dir=$(git rev-parse --show-toplevel)
cd $root_dir
mkdir -p .cover

# run go tests
go clean -testcache
coverage=$(TZ=Etc/UTC go test "$@" ./... -cover -coverprofile=.cover/profile.out)
testfail="$?"

# check if there are test failures
if [[ "testfail" -ne 0 ]]; then
    echo "$coverage"
    exit 1
fi

# generate profile data
go tool cover -html=.cover/profile.out -o .cover/profile.html
files=$(grep -oE 'gitlab.com/gnufred/logslate/[a-z/]*\.go \([0-9]*\.[0-9]%\)' .cover/profile.html)


if [[ -n "$files" ]]; then
    while IFS= read -r result; do
        # get percentage
        file=$(echo "$result"|awk '{print $1}'|sed "s,gitlab.com/gnufred/logslate/,,")
        min="${minCov[$file]}"
        cover=$(echo "$result"|awk '{print $2}'|sed 's,[()%],,g'|cut -d. -f1)
        if [[ $cover -lt $min ]]; then
            status="NO"
        else
            status="--"
        fi
        table="${table}$file,$min,$cover,$status\n"
    done <<< "$files"
fi

wc=$(which tidy-viewer 2> /dev/null)
if [[ "$?" -eq "0" ]]; then
	echo -e "FILE,MIN,COV,OK\n$table"|tidy-viewer --no-dimensions
else
	echo -e "$table"|sed 's/,/  /g'
fi

fails=$(echo -e "$table"|grep NO)
if [[ -n "$fails" ]]; then
    echo -e "\nError: minimum coverage not reached"
    echo "$fails"|cut -d, -f1
    exit 1
fi
