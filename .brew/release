#!/bin/bash

########################################
echo "Preparing brew release variables."

BREW_RELEASE_VERSION=$CI_COMMIT_TAG
echo "release: ${BREW_RELEASE_VERSION}"

BREW_SHA256_PACKAGE_LINUX=$(sha256sum -z ".bin/${LINUX_AMD64_BINARY}" | cut -d' ' -f1)
echo "${LINUX_AMD64_BINARY} sha256: $BREW_SHA256_PACKAGE_LINUX"
if [[ -z "$BREW_SHA256_PACKAGE_LINUX" ]]; then
	echo "fatal: nil sha256sum"
	exit 1
fi

BREW_SHA256_PACKAGE_DARWIN=$(sha256sum -z ".bin/${DARWIN_AMD64_BINARY}" | cut -d' ' -f1)
echo "${DARWIN_AMD64_BINARY} sha256: $BREW_SHA256_PACKAGE_DARWIN"
if [[ -z "$BREW_SHA256_PACKAGE_DARWIN" ]]; then
	echo "fatal: nil sha256sum"
	exit 1
fi


##################################
echo "Creating brew release file."

export BREW_RELEASE_VERSION
export BREW_SHA256_PACKAGE_LINUX
export BREW_SHA256_PACKAGE_DARWIN

bash .brew/template.rb > "${BREW_BIN}.rb"


#####################################################
echo "Commiting brew release file to release branch."
git config user.email "${BREW_BOT_EMAIL}"
git config user.name "ci-brew-release"
git remote add gitlab "https://oauth2:${CI_BREW_TOKEN}@${BREW_GITLAB_URL}"
git add "${BREW_BIN}.rb"
git commit -m "Brew release ${BREW_RELEASE_VERSION}"

# IMPORTANT: `-o ci.skip` tell GitLab to skip pipelines
# Watch out, you can end up with infinite pipeline loop
git push gitlab HEAD:refs/heads/"${BREW_RELEASE_VERSION}" -o ci.skip
