#!/bin/bash

# https://docs.gitlab.com/ee/user/project/releases/release_cli.html#install-on-unixlinux

echo "Installing GitLab release CLI."
curl -s --location --output /usr/local/bin/release-cli "https://gitlab.com/api/v4/projects/gitlab-org%2Frelease-cli/packages/generic/release-cli/latest/release-cli-linux-amd64"
chmod +x /usr/local/bin/release-cli

echo "Preparing release data."
GIT_TAG_MSG=$(git tag -l --format='%(contents)' $CI_COMMIT_TAG)
RELEASE_TITLE=$(echo "$GIT_TAG_MSG"|head -n1)
RELEASE_BODY=$(echo "$GIT_TAG_MSG"|tail -n +2)

echo "Creating release."
release-cli create \
    --name "$RELEASE_TITLE" \
    --description "$RELEASE_BODY" \
    --tag-name $CI_COMMIT_TAG \
    --assets-link "{\"name\":\"${LINUX_AMD64_BINARY}\",\"url\":\"${PACKAGE_REGISTRY_CURRENT}/${LINUX_AMD64_BINARY}\",\"link_type\":\"package\"}" \
    --assets-link "{\"name\":\"${DARWIN_AMD64_BINARY}\",\"url\":\"${PACKAGE_REGISTRY_CURRENT}/${DARWIN_AMD64_BINARY}\",\"link_type\":\"package\"}" \
    --assets-link "{\"name\":\"${WINDOWS_AMD64_BINARY}\",\"url\":\"${PACKAGE_REGISTRY_CURRENT}/${WINDOWS_AMD64_BINARY}\",\"link_type\":\"package\"}"
