#!/bin/sh
exit

# Pre-commit hook. Run
# `ln -s ../../.sh/pre-commit .git/hooks/pre-commit`
# from git repo root to enable.

root_dir=$(git rev-parse --show-toplevel)
cd $root_dir

printf "lint "
bash .sh/lint > /dev/null
if [[ "$?" -ne "0" ]]; then
    printf "[fail]"
    exit 1
else
    printf "[ok]"
fi

printf " test "
bash .sh/test > /dev/null
if [[ "$?" -ne "0" ]]; then
    printf "[fail]"
    exit 1
else
    printf "[ok]"
fi

echo ""
sleep 0.2
