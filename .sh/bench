#!/bin/bash

root_dir=$(git rev-parse --show-toplevel)
cd $root_dir

go clean -testcache

# prepare script variables
ts=$(date +"%y%m%d%H%M%S")
log=".bench/${ts}-${pkg}.log"
mkdir -p .bench

# list packages
pkg="$1"
if [[ -z "$1" ]]; then
	pkg=$(rg 'testing.B' -l|cut -d/ -f1|sort|uniq)
fi

# run package benchmark
for p in $pkg; do
	TZ=Etc/UTC go test "./$p/..." -bench package -bench=. | tee -a $log
done
