#!/bin/bash

root_dir=$(git rev-parse --show-toplevel)
cd $root_dir

ver=$(git describe --tags --always)

mkdir -p .bin
rm -f .bin/logslate-*

# linux 64
GOOS=linux GOARCH=amd64 \
    go build \
    -ldflags="-X 'main.Version=${ver}'" \
    -o .bin/logslate-amd64-linux

# mac 64
GOOS=darwin GOARCH=amd64 \
    go build \
    -ldflags="-X 'main.Version=${ver}'" \
    -o .bin/logslate-amd64-darwin

# windows 64
GOOS=windows GOARCH=amd64 \
    go build \
    -ldflags="-X 'main.Version=${ver}'" \
    -o .bin/logslate-amd64-windows.exe
